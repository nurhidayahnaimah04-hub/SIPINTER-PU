# ==== Server ====
PORT=8000
APP_URL=http://localhost:8000

# ==== Frontend (untuk CORS) ====
FRONTEND_URL=http://localhost:5173

# ==== Database PostgreSQL (Supabase) ====
# Ambil dari Supabase: Project Settings -> Database -> Connection string (URI)
# Contoh: postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:bapekompu2026@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Set "true" jika koneksi ke Supabase memerlukan SSL (biasanya ya, untuk koneksi non-local)
DB_SSL=true

# ==== Auth ====
# Panjang minimal 32 karakter, gunakan string acak & rahasia di production
BCRYPT_ROUNDS=12
