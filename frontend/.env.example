# Kosongkan (biarkan default '/api') kalau pakai proxy dev bawaan vite.config.js.
# Isi kalau frontend & backend dideploy terpisah (production), contoh:
# VITE_API_URL=https://api.domainanda.go.id/api
VITE_API_URL=

# URL backend Express untuk keperluan proxy saat development
VITE_API_URL=
VITE_BACKEND_URL=http://localhost:8000
